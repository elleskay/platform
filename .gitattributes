# LF everywhere, in the repo and in every checkout (matches .editorconfig).
# Without this, a Windows clone with core.autocrlf gets CRLF files, and the
# shell scripts then fail under WSL or Linux with "$'\r': command not found".
* text=auto eol=lf

# Binary assets: never rewrite line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff2 binary
*.zip binary
