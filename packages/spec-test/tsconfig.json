{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    // Keep the incremental-build state inside dist so `rm -rf dist` cannot
    // leave a stale .tsbuildinfo that makes the next build emit nothing.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
